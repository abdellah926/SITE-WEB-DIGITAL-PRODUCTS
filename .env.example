# --- Database (PostgreSQL) ---
# Required for live data. Pages degrade to empty states when unset.
DATABASE_URL=

# --- Shop WhatsApp number for orders ---
# International format without "+" (e.g. 212612345678).
NEXT_PUBLIC_SHOP_PHONE=

# --- Admin auth (min 16 chars for ADMIN_SECRET) ---
ADMIN_PASSWORD=
ADMIN_SECRET=

# --- Public site URL (used by sitemap/robots/metadata) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000